<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>driveBox - Dashboard | <%= currentFolder.name %></title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <%- include("../partials/header.ejs") %>

    <main class="folder-content">
      <aside class="folder-sidebar">
        <section class="folder-info">
          <h2>My Drive</h2>
          <span>Hi, <%= user.username %>!</span>
        </section>

        <section class="folder-actions top">
          <div>
            <button type="button" class="btn open-modal">New File</button>
            <dialog>
              <form class="new-file-form">
                <h4>New File</h4>
                <input type="file" name="newFile" id="new-file" />
                <div class="form-group">
                  <button type="submit">Upload File</button>
                  <button type="button" class="btn close-modal">Cancel</button>
                </div>
              </form>
            </dialog>
          </div>
        </section>

        <section class="folder-actions bottom">
          <form action="/auth/sign-out" method="POST">
            <button type="submit">Sign Out</button>
          </form>
        </section>
      </aside>

      <div class="folder-main">
        <nav>
          <ol>
            <li><a href="/dashboard">Dashboard</a><span>&gt;</span></li>
            <li><%= currentFolder.name %></li>
          </ol>
        </nav>

        <section>
          <h3><%= currentFolder.name %></h3>
        </section>
      </div>
    </main>

    <script>
      document
        .querySelector(".btn.open-modal")
        .addEventListener("click", () => {
          document.querySelector("dialog").showModal();
        });

      document
        .querySelector(".btn.close-modal")
        .addEventListener("click", () => {
          document.querySelector("dialog").close();
        });
    </script>
  </body>
</html>
