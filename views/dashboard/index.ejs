<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>driveBox - Dashboard</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <%- include("../partials/header.ejs") %>

    <main class="dashboard-content">
      <aside class="sidebar dashboard">
        <section class="sidebar-header">
          <h2>Dashboard</h2>
          <span>Hi, <%= user.username %>!</span>
        </section>

        <section class="sidebar-body">
          <div class="sidebar-action">
            <dialog>
              <form
                action="/dashboard/create-folder"
                method="POST"
                class="form new-folder"
              >
                <h4>New Folder</h4>

                <div class="form-group">
                  <label for="new-folder">Name</label>
                  <input
                    type="text"
                    name="newFolder"
                    id="new-folder"
                    placeholder="Meme Collections"
                  />
                </div>

                <div class="form-group buttons">
                  <button type="submit">Create</button>
                  <button type="button" class="btn close-modal">Cancel</button>
                </div>
              </form>
            </dialog>

            <button type="button" class="btn open-modal">New Folder</button>
          </div>

          <div class="sidebar-action">
            <dialog>
              <form
                action="/dashboard/upload-file"
                method="POST"
                enctype="multipart/form-data"
                class="form new-file"
              >
                <h4>New File</h4>

                <input type="file" name="newFile" id="new-file" />

                <div class="form-group buttons">
                  <button type="submit">Upload</button>
                  <button type="button" class="btn close-modal">Cancel</button>
                </div>
              </form>
            </dialog>

            <button type="button" class="btn open-modal">New File</button>
          </div>

          <div class="sidebar-action">
            <form action="/auth/sign-out" method="POST" class="form sign-out">
              <button type="submit">Sign Out</button>
            </form>
          </div>
        </section>
      </aside>

      <div class="main dashboard">
        <section class="folders-wrapper">
          <h3>
            <% if (folders.length > 0) { %> All Folders (<%= folderCount %>) <%
            } else { %> All Folders <% } %>
          </h3>

          <% if (folders.length > 0) { %>
          <div class="table">
            <div class="table-header">
              <span>Name</span>
              <span>&vellip;</span>
            </div>

            <ul class="table-body">
              <% folders.forEach(({id, name, createdAt, editedAt}) => { %>
              <li class="table-rows">
                <a href="/dashboard/folder/<%= id %>" title="<%= name %>"
                  ><%= name %></a
                >

                <span class="row-dropdown"
                  >&vellip;

                  <div class="row-actions hide">
                    <form
                      action="/dashboard/delete-folder/<%= id %>?_method=DELETE"
                      method="POST"
                      class="form delete-folder"
                    >
                      <button type="submit">Delete</button>
                    </form>

                    <div class="action rename-folder">
                      <dialog>
                        <form
                          action="/dashboard/rename-folder/<%= id %>?_method=PUT"
                          method="POST"
                          class="form rename-folder"
                        >
                          <h4>Rename Folder</h4>

                          <div class="form-group rename-folder">
                            <label>
                              Name
                              <input
                                type="text"
                                name="renameFolder"
                                value="<%= name %>"
                                placeholder="Meme Collections"
                              />
                            </label>
                          </div>

                          <div class="form-group buttons">
                            <button type="submit">Rename</button>
                            <button type="button" class="btn close-modal">
                              Cancel
                            </button>
                          </div>
                        </form>
                      </dialog>

                      <button type="button" class="btn open-modal">
                        Rename
                      </button>
                    </div>

                    <div class="action details">
                      <dialog>
                        <div class="details-wrapper">
                          <h3 title="<%= name %>"><%= name %></h3>

                          <div class="detail-group">
                            <h4>Folder Details</h4>

                            <div class="detail date-added">
                              <span>Date Added</span>
                              <span
                                ><%= createdAt.toLocaleString("en-GB") %></span
                              >
                            </div>

                            <div class="detail last-edited">
                              <span>Last Edited</span>
                              <span
                                ><%= editedAt.toLocaleString("en-GB") %></span
                              >
                            </div>
                          </div>

                          <button type="button" class="btn close-modal">
                            Close
                          </button>
                        </div>
                      </dialog>

                      <button type="button" class="btn open-modal">
                        Details
                      </button>
                    </div>
                  </div>
                </span>
              </li>
              <% }) %>
            </ul>
          </div>

          <% } else { %>
          <div><span>No folders available yet.</span></div>
          <% } %>
        </section>

        <section class="files-wrapper">
          <h3>
            <% if (files.length > 0) { %> All Files (<%= fileCount %>) <% } else
            { %> All Files <% } %>
          </h3>

          <% if (files.length > 0) { %>
          <div class="table">
            <div class="table-header">
              <span>Name</span>
              <span>&vellip;</span>
            </div>

            <ul class="table-body">
              <% files.forEach(({id, name, uploadedAt, size, mimetype}) => { %>
              <li class="table-rows">
                <span title="<%= name %>"><%= name %></span>

                <span class="row-dropdown"
                  >&vellip;

                  <div class="row-actions hide">
                    <form
                      action="/dashboard/delete-file/<%= id %>?_method=DELETE"
                      method="POST"
                      class="form delete-file"
                    >
                      <button type="submit">Delete</button>
                    </form>

                    <form
                      action="/dashboard/download-file/<%= id %>"
                      method="POST"
                      class="form download-file"
                    >
                      <button type="submit">Download</button>
                    </form>

                    <div class="action details">
                      <dialog>
                        <div class="details-wrapper">
                          <h3 title="<%= name %>"><%= name %></h3>

                          <div class="detail-group">
                            <h4>File Details</h4>

                            <div class="detail date-added">
                              <span>Date Added</span>
                              <span
                                ><%= uploadedAt.toLocaleString("en-GB") %></span
                              >
                            </div>

                            <div class="detail size">
                              <span>Size</span>
                              <span><%= size %></span>
                            </div>

                            <div class="detail mimetype">
                              <span>File Type</span>
                              <span><%= mimetype %></span>
                            </div>
                          </div>

                          <button type="button" class="btn close-modal">
                            Close
                          </button>
                        </div>
                      </dialog>

                      <button type="button" class="btn open-modal">
                        Details
                      </button>
                    </div>
                  </div>
                </span>
              </li>
              <% }) %>
            </ul>
          </div>

          <% } else { %>
          <div><span>No files available yet.</span></div>
          <% } %>
        </section>
      </div>
    </main>

    <script>
      document.querySelectorAll(".btn.open-modal").forEach((button) => {
        button.addEventListener("click", (e) => {
          e.stopPropagation();
          button.closest("div").querySelector("dialog").showModal();
        });
      });

      document.querySelectorAll(".btn.close-modal").forEach((button) => {
        button.addEventListener("click", () => {
          button.closest("dialog").close();
          button.closest("form")?.reset();

          document.querySelectorAll(".row-actions").forEach((action) => {
            action.classList.add("hide");
          });
        });
      });

      document.querySelectorAll(".row-dropdown").forEach((dropdown) => {
        dropdown.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll(".row-actions").forEach((action) => {
            if (action !== dropdown.querySelector(".row-actions")) {
              action.classList.add("hide");
            }
          });

          dropdown.querySelector(".row-actions").classList.toggle("hide");
        });
      });

      document.querySelectorAll(".row-actions").forEach((actions) => {
        actions.addEventListener("click", (e) => {
          e.stopPropagation();
        });
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest(".row-actions")) {
          document.querySelectorAll(".row-actions").forEach((action) => {
            action.classList.add("hide");
          });
        }
      });
    </script>
  </body>
</html>
