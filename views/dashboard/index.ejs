<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>driveBox - Dashboard</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <%- include("../partials/header.ejs") %>

    <main class="dashboard-content">
      <aside class="dashboard-sidebar">
        <section class="dashboard-info">
          <h2>Dashboard</h2>
          <span>Hi, <%= user.username %>!</span>
        </section>

        <section class="dashboard-actions top">
          <div>
            <button type="button" class="btn open-modal">New Folder</button>
            <dialog>
              <form
                action="/dashboard/create-folder"
                method="POST"
                class="new-folder-form"
              >
                <h4>New Folder</h4>

                <div class="form-group">
                  <label for="new-folder">Folder Name</label>
                  <input
                    type="text"
                    name="newFolder"
                    id="new-folder"
                    placeholder="Meme Collections"
                  />
                </div>

                <div class="form-group">
                  <button type="submit">Create Folder</button>
                  <button type="button" class="btn close-modal">Cancel</button>
                </div>
              </form>
            </dialog>
          </div>

          <div>
            <button type="button" class="btn open-modal">New File</button>
            <dialog>
              <form
                action="/dashboard/upload-file"
                method="POST"
                enctype="multipart/form-data"
                class="new-file-form"
              >
                <h4>New File</h4>
                <input type="file" name="newFile" id="new-file" />
                <div class="form-group">
                  <button type="submit">Upload File</button>
                  <button type="button" class="btn close-modal">Cancel</button>
                </div>
              </form>
            </dialog>
          </div>
        </section>

        <section class="dashboard-actions bottom">
          <form action="/auth/sign-out" method="POST">
            <button type="submit">Sign Out</button>
          </form>
        </section>
      </aside>

      <div class="dashboard-main">
        <section class="my-folders">
          <h3>
            <% if (folders.length > 0) { %> Folders (<%= folderCount %>) <% }
            else { %> Folders <% } %>
          </h3>

          <% if (folders.length > 0) { %>
          <div class="folder-table">
            <div class="folder-header">
              <span>Name</span>
              <span>Date Added</span>
              <span>Last Edited</span>
              <span>Actions</span>
            </div>

            <ul class="folder-body">
              <% folders.forEach(({id, name, createdAt, editedAt}) => { %>
              <li>
                <a href="/dashboard/folder/<%= id %>"><%= name %></a>
                <span><%= createdAt.toLocaleString("en-GB") %></span>
                <span><%= editedAt.toLocaleString("en-GB") %></span>
                <div class="body-actions">
                  <form
                    action="/dashboard/delete-folder/<%= id %>?_method=DELETE"
                    method="POST"
                  >
                    <button type="submit">Delete</button>
                  </form>

                  <div>
                    <button type="button" class="btn open-modal">Rename</button>
                    <dialog>
                      <form
                        action="/dashboard/rename-folder/<%= id %>?_method=PUT"
                        method="POST"
                        class="rename-folder-form"
                      >
                        <h3><%= name %></h3>

                        <div class="form-group rename-folder">
                          <label>
                            Folder Name
                            <input
                              type="text"
                              name="renameFolder"
                              placeholder="Meme Collections"
                            />
                          </label>
                        </div>

                        <div class="form-group">
                          <button type="submit">Rename Folder</button>
                          <button type="button" class="btn close-modal">
                            Cancel
                          </button>
                        </div>
                      </form>
                    </dialog>
                  </div>
                </div>
              </li>
              <% }) %>
            </ul>
          </div>

          <% } else { %>
          <div><span>No folders available yet.</span></div>
          <% } %>
        </section>

        <section class="my-files">
          <h3>
            <% if (files.length > 0) { %> Files (<%= fileCount %>) <% } else {
            %> Files <% } %>
          </h3>

          <% if (files.length > 0) { %>
          <div class="file-table">
            <div class="file-header">
              <span>Name</span>
              <span>Size</span>
              <span>Date Added</span>
              <span>Actions</span>
            </div>

            <ul class="file-body">
              <% files.forEach(({id, name, uploadedAt, size, url}) => { %>
              <li>
                <span title="<%= name %>"><%= name %></span>
                <span><%= size %></span>
                <span><%= uploadedAt.toLocaleString("en-GB") %></span>
                <div class="body-actions">
                  <form
                    action="/dashboard/delete-file/<%= id %>?_method=DELETE"
                    method="POST"
                  >
                    <button type="submit">Delete</button>
                  </form>

                  <form
                    action="/dashboard/download-file/<%= id %>"
                    method="POST"
                  >
                    <button type="submit">Download</button>
                  </form>
                </div>
              </li>
              <% }) %>
            </ul>
          </div>

          <% } else { %>
          <div><span>No files available yet.</span></div>
          <% } %>
        </section>
      </div>
    </main>

    <script>
      document.querySelectorAll(".btn.open-modal").forEach((button) => {
        button.addEventListener("click", () => {
          button.closest("div").querySelector("dialog").showModal();
        });
      });

      document.querySelectorAll(".btn.close-modal").forEach((button) => {
        button.addEventListener("click", () => {
          button.closest("dialog").close();
          button.closest("form").reset();
        });
      });
    </script>
  </body>
</html>
